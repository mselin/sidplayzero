# SPEC-148 SPEC-102 a check that cannot fetch the file says so, and adds no row
# parts: releases
# fakes: fakes/hvsc_accepted
# fixture: collections/84/C64Music/DOCUMENTS C64Music/DOCUMENTS
fake http down
key Tab
key 5
expect rows[0].text = "Check for a newer release"
key Enter
expect notice.id = MSG_CHECK_FAILED
expect rows matches ^(?![\s\S]*Update to)
expect lines contains "HVSC #84"
expect-file C64Music/DOCUMENTS/hv_sids.txt contains "Release 84"
