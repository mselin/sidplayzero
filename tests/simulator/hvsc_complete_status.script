# SPEC-102 SPEC-144 SPEC-131 after Download everything the status block says HVSC #85, complete, and state.ini holds hvsc_complete_release (FIND-031)
# parts: download-all
# fakes: fakes/hvsc_archive
# fixture: collections/85/C64Music/DOCUMENTS C64Music/DOCUMENTS
key Tab
key 5
expect screen = hvsc
expect lines contains "HVSC #85"
expect lines matches ^(?![\s\S]*complete)
expect rows matches "Download everything"
# The row before the last one, "Rebuild the index".
key End
key Up
key Enter
expect panel.id = notice-panel
key Enter
expect notice.id = MSG_DOWNLOAD_DONE
expect-file C64Music/MUSICIANS/H/Hubbard_Rob/Commando.sid exists
expect lines contains "HVSC #85, complete"
# SPEC-131: saved two seconds after the change.
advance 3000
expect-file .local/state/sidplayzero/state.ini contains "hvsc_complete_release = 85"
# It is remembered: started again, the collection is still complete for 85.
restart
key Tab
key 5
expect lines contains "HVSC #85, complete"
