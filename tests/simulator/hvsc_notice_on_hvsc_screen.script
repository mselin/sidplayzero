# SPEC-152 SPEC-140 Get HVSC on the HVSC screen opens the notice panel and makes no request; ESC makes none; Enter makes the five
# fakes: fakes/hvsc_server
key Tab
key 5
expect rows[0].text = "Get HVSC"
key Enter
expect panel.id = notice-panel
expect-requests 0
expect job = null
key Esc
expect panel = null
expect-requests 0
expect job = null
expect screen = hvsc
expect rows[0].text = "Get HVSC"
expect-file C64Music/DOCUMENTS absent
key Enter
expect panel.id = notice-panel
key Enter
expect-requests 5
expect notice.id = MSG_HVSC_READY
