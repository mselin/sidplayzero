# SPEC-152 SPEC-141 with the notice not accepted, Enter on an absent tune opens the notice panel and makes no request; ESC makes none; Enter makes the request and the tune plays
# fakes: fakes/hvsc_server
# fixture: collections/85/C64Music/DOCUMENTS C64Music/DOCUMENTS
# args: --backend fake
expect screen = browser
# To /MUSICIANS/H/Hubbard_Rob: the root lists DEMOS, GAMES and MUSICIANS.
key Down
key Down
key Enter
expect title = /MUSICIANS
key Enter
key Enter
expect title = /MUSICIANS/H/Hubbard_Rob
expect rows[0].text = Commando.sid
expect rows[0].marks contains absent
key Enter
expect panel.id = notice-panel
expect-requests 0
key Esc
expect panel = null
expect-requests 0
expect-file C64Music/MUSICIANS/H/Hubbard_Rob/Commando.sid absent
expect player.state != playing
expect player.state != fetching
advance 5000
expect-requests 0
key Enter
expect panel.id = notice-panel
key Enter
expect panel = null
expect-requests 1
expect-request 1 https://hvsc.c64.org/download/C64Music/MUSICIANS/H/Hubbard_Rob/Commando.sid
expect-file C64Music/MUSICIANS/H/Hubbard_Rob/Commando.sid exists
expect player.state = playing
expect player.path = /MUSICIANS/H/Hubbard_Rob/Commando.sid
advance 2100
expect-file .local/state/sidplayzero/state.ini contains "notice_accepted = on"
