# SPEC-148 SPEC-144 SPEC-102 Update to #85 of a collection complete for 84 runs the complete download of 85: the collection is complete for 85, 84's own file is gone and the user's file is kept (FIND-031)
# parts: releases download-all
# fakes: fakes/hvsc_complete
# fixture: collections/84/C64Music C64Music
# fixture: tunes/own_tune.sid C64Music/My_Rips/Own.sid
key Tab
key 5
expect screen = hvsc
expect lines contains "HVSC #84, complete"
expect rows[0].text = "Check for a newer release"
key Enter
expect-requests 1
expect-request 1 https://hvsc.c64.org/download/C64Music/DOCUMENTS/hv_sids.txt
expect notice.id = MSG_HVSC_NEWER
expect rows[1].text = "Update to #85"
advance 4000
key Down
expect rows[1].highlighted = true
key Enter
expect notice.id = MSG_DOWNLOAD_DONE
# The archive of 85, and no document on its own.
expect-requests 2
expect-request 2 https://hvsc.brona.dk/HVSC/HVSC_85-all-of-them.7z
expect-log unpacker contains "unpack "
expect-file C64Music/DOCUMENTS/hv_sids.txt contains "Release 85"
expect-file C64Music/DEMOS/A-F/Clock_Demo.sid exists
expect-file C64Music/MUSICIANS/T/Tester_Tom/Renamed.sid exists
expect-file C64Music/MUSICIANS/T/Tester_Tom/Old_Name.sid absent
expect-file C64Music/My_Rips/Own.sid exists
expect-file .sidplayzero-staging absent
expect lines contains "HVSC #85, complete"
expect rows matches ^(?![\s\S]*Update to)
advance 3000
expect-file .local/state/sidplayzero/state.ini contains "hvsc_complete_release = 85"
