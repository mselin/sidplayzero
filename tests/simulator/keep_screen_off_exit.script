# SPEC-207 SPEC-201 with the screen turned off by the app, leaving puts the brightness back
# parts: screen-off
# fixture: collections/85/C64Music C64Music
# fixture: keep/settings_screen_off_10.ini .config/sidplayzero/settings.ini
# fakes: fakes/keep_backlight_70
# args: --backend fake
key Enter
key Enter
key Enter
expect player.state = playing
advance 10000
expect-log backlight contains "set 0"
expect-file .local/state/sidplayzero/state.ini contains "backlight_saved = 70"
quit
expect-log backlight contains "set 70"
