# SPEC-201 SPEC-131 a held ESC stops the player, writes state.ini and leaves with status 0; the next start has the tune as its current entry, idle
# fixture: collections/85/C64Music C64Music
# args: --backend fake
key Enter
key Enter
key Enter
expect screen = playing
expect player.state = playing
expect player.path = /DEMOS/A-F/Clock_Demo.sid
# One second of the fake clock: too soon for the two-second save, so what follows was written by the exit.
hold Esc 1000
expect-file .local/state/sidplayzero/state.ini contains "current_path = /DEMOS/A-F/Clock_Demo.sid"
expect-file .local/state/sidplayzero/state.ini contains "browser_folder = /DEMOS/A-F"
expect-file .local/state/sidplayzero/state.ini contains "browser_entry = Clock_Demo.sid"
# The lock was released: the app starts again in the same home folder.
restart
expect screen = browser
expect title = /DEMOS/A-F
expect player.state = idle
expect player.path = /DEMOS/A-F/Clock_Demo.sid
