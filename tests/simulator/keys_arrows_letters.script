# SPEC-093 on the browser the letter X and the Down key code each move the highlight one row, and F, Z and C do what Up, Left and Right do
# fixture: collections/85/C64Music C64Music
expect screen = browser
expect title = /
expect rows[0].text = DEMOS
expect rows[0].highlighted = true
expect position = 1/3
key X
expect rows[1].highlighted = true
expect rows[0].highlighted = false
expect position = 2/3
key Down
expect rows[2].highlighted = true
expect position = 3/3
key F
expect rows[1].highlighted = true
expect position = 2/3
key Up
expect rows[0].highlighted = true
expect position = 1/3
# C is Right, which opens the folder; Z is Left, which goes to the parent
key C
expect title = /DEMOS
key Z
expect title = /
expect rows[0].highlighted = true
key Right
expect title = /DEMOS
key Left
expect title = /
expect screen = browser
