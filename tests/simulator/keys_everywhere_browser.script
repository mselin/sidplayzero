# SPEC-092 on the browser each key of `always`, of `lists` and of `screens` has its effect
# fixture: tunes/commando_test.sid C64Music/A_Commando.sid
# fixture: tunes/three_subtunes.sid C64Music/B_Three.sid
# fixture: tunes/two_sid.sid C64Music/C_Two.sid
# args: --backend fake
expect screen = browser
key Down
key Enter
expect screen = playing
expect player.state = playing
expect player.path = /B_Three.sid
key Esc
expect screen = browser
expect rows[1].highlighted = true
# the keys of `always`: play or pause, next and previous tune
key PlayPause
expect player.state = paused
key PlayPause
expect player.state = playing
key Next
expect player.path = /C_Two.sid
key Previous
expect player.path = /B_Three.sid
expect player.state = playing
# volume and mute, from the fake's 50 %
key VolumeUp
expect notice.id = MSG_VOLUME
expect notice.text = "Volume 55 %"
expect-log volume contains "set 55"
key VolumeDown
expect notice.text = "Volume 50 %"
expect-log volume contains "set 50"
key Mute
expect notice.id = MSG_VOLUME
expect notice.text = Muted
expect-log volume contains toggle_mute
key Mute
# help opens over it and closes again
key Help
expect place = help
expect help != null
key Help
expect help = null
expect place = browser
# the keys of `lists`
key Home
expect rows[0].highlighted = true
expect position = 1/3
key End
expect rows[2].highlighted = true
expect position = 3/3
key Up
expect rows[1].highlighted = true
key Down
expect rows[2].highlighted = true
key PageUp
expect rows[0].highlighted = true
key PageDown
expect rows[2].highlighted = true
# the keys of `screens`
key Space
expect player.state = paused
key Space
expect player.state = playing
key Tab
expect screen = settings
key Esc
expect screen = browser
key P
expect screen = playing
expect stack = ["browser","playing"]
# ESC closes the screen on top; on the browser, at the root, it closes nothing; held, it leaves
key Esc
expect screen = browser
key Esc
expect screen = browser
expect stack = ["browser"]
hold Esc 1000
