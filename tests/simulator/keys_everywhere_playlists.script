# SPEC-092 on the two playlist screens and in a list panel the keys of `always`, of `lists` and of `screens` have their effect
# parts: playlists
# fixture: tunes/commando_test.sid C64Music/A_Commando.sid
# fixture: tunes/three_subtunes.sid C64Music/B_Three.sid
# fixture: tunes/two_sid.sid C64Music/C_Two.sid
# args: --backend fake
expect screen = browser
key 7
key Down
key 7
key Down
key 7
expect notice.id = MSG_FAV_ADDED
key Up
key Enter
expect screen = playing
expect player.path = /B_Three.sid
key Esc
# a list panel: the keys of `lists` move its highlight, and TAB and P do nothing
key 8
expect panel.id = pick-playlist
expect panel.rows[0].highlighted = true
key Down
expect panel.rows[1].highlighted = true
key Up
expect panel.rows[0].highlighted = true
key End
expect panel.rows[0].highlighted = false
key Home
expect panel.rows[0].highlighted = true
key Tab
key P
expect panel.id = pick-playlist
expect stack = ["browser"]
key Mute
expect notice.text = Muted
key Mute
expect panel.id = pick-playlist
key Esc
expect panel = null
# the Playlists screen
key 6
expect screen = playlists
# the keys of `always`: play or pause, next and previous tune
key PlayPause
expect player.state = paused
key PlayPause
expect player.state = playing
key Next
expect player.path = /C_Two.sid
key Previous
expect player.path = /B_Three.sid
expect player.state = playing
# volume and mute, from the fake's 50 %
key VolumeUp
expect notice.id = MSG_VOLUME
expect notice.text = "Volume 55 %"
expect-log volume contains "set 55"
key VolumeDown
expect notice.text = "Volume 50 %"
expect-log volume contains "set 50"
key Mute
expect notice.id = MSG_VOLUME
expect notice.text = Muted
expect-log volume contains toggle_mute
key Mute
# help opens over it and closes again
key Help
expect place = help
expect help != null
key Help
expect help = null
expect place = playlists
key Space
expect player.state = paused
key Space
expect player.state = playing
key Tab
expect screen = settings
key Esc
expect screen = playlists
# the Playlist screen: Favourites, with three entries
key Enter
expect screen = playlist
expect rows[0].highlighted = true
# the keys of `always`: play or pause, next and previous tune
key PlayPause
expect player.state = paused
key PlayPause
expect player.state = playing
key Next
expect player.path = /C_Two.sid
key Previous
expect player.path = /B_Three.sid
expect player.state = playing
# volume and mute, from the fake's 50 %
key VolumeUp
expect notice.id = MSG_VOLUME
expect notice.text = "Volume 55 %"
expect-log volume contains "set 55"
key VolumeDown
expect notice.text = "Volume 50 %"
expect-log volume contains "set 50"
key Mute
expect notice.id = MSG_VOLUME
expect notice.text = Muted
expect-log volume contains toggle_mute
key Mute
# help opens over it and closes again
key Help
expect place = help
expect help != null
key Help
expect help = null
expect place = playlist
key Down
expect rows[1].highlighted = true
key End
expect rows[2].highlighted = true
key Up
expect rows[1].highlighted = true
key Home
expect rows[0].highlighted = true
key PageDown
expect rows[2].highlighted = true
key PageUp
expect rows[0].highlighted = true
key Space
expect player.state = paused
key Space
expect player.state = playing
key P
expect screen = playing
expect stack = ["browser","playlists","playlist","playing"]
key Esc
expect screen = playlist
key Esc
expect screen = playlists
key Esc
expect screen = browser
hold Esc 1000
