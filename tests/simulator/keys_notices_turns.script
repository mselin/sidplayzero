# SPEC-113 three different notices raised at once show one after another, three seconds of the clock each
# fakes: fakes/keys_notices
# fixture: tunes/commando_test.sid C64Music/A_Commando.sid
# fixture: tunes/three_subtunes.sid C64Music/B_Three.sid
# fixture: tunes/two_sid.sid C64Music/C_Two.sid
expect screen = browser
expect notice.id = MSG_SETTINGS_RESET
key VolumeUp
fake volume.works no
key VolumeUp
expect notice.id = MSG_SETTINGS_RESET
advance 2990
expect notice.id = MSG_SETTINGS_RESET
advance 20
expect notice.id = MSG_VOLUME
expect notice.text = "Volume 55 %"
advance 2980
expect notice.id = MSG_VOLUME
advance 20
expect notice.id = MSG_VOLUME_FAILED
expect notice.text = "The volume could not be changed"
advance 2980
expect notice.id = MSG_VOLUME_FAILED
advance 20
expect notice = null
advance 5000
expect notice = null
