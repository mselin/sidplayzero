# SPEC-099 the Search field holds 64 characters, and the 65th is not added
# fixture: tunes/commando_test.sid C64Music/A_Commando.sid
# fixture: tunes/three_subtunes.sid C64Music/B_Three.sid
# fixture: tunes/two_sid.sid C64Music/C_Two.sid
expect screen = browser
key 5
expect place = search-field
type 012345678901234567890123456789012345678901234567890123456789abcd
expect fields contains ""text":"012345678901234567890123456789012345678901234567890123456789abcd""
expect fields matches "cursor.:64[,}]"
key B
expect fields contains ""text":"012345678901234567890123456789012345678901234567890123456789abcd""
type 123
key Space
expect fields contains ""text":"012345678901234567890123456789012345678901234567890123456789abcd""
expect fields matches "cursor.:64[,}]"
# with one character removed there is room for one again
key Backspace
key Z
expect fields contains ""text":"012345678901234567890123456789012345678901234567890123456789abcz""
