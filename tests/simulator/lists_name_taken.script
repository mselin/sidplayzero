# SPEC-172 a second playlist with the same name in other case is refused with MSG_NAME_TAKEN, and so is the name Favourites
# parts: playlists
# fixture: collections/85/C64Music C64Music
# args: --backend fake
expect screen = browser
key 6
expect screen = playlists
key 5
expect panel.id = prompt
type Loading
key Enter
expect list.total = 2
expect-file .local/share/sidplayzero/playlists/Loading.m3u8 exists

key 5
expect panel.id = prompt
type LOADING
key Enter
expect notice.id = MSG_NAME_TAKEN
expect-file .local/share/sidplayzero/playlists/LOADING.m3u8 absent
# Whether the prompt stays open after the refusal is not said. Two presses of ESC reach the browser at
# its root either way, where ESC does nothing.
key Esc
key Esc
expect screen = browser
key 6
expect screen = playlists
expect list.total = 2
advance 3000

key 5
type favourites
key Enter
expect notice.id = MSG_NAME_TAKEN
key Esc
key Esc
expect screen = browser
key 6
expect list.total = 2
expect rows[0].text contains Favourites
expect rows[1].text contains Loading
