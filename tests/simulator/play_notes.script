# SPEC-097 Notes opens a text panel with the playing tune's entry from STIL, its é shown as that letter
# parts: notes
# fixture: collections/85/C64Music C64Music
# args: --backend fake
expect screen = browser
key Down
key Down
key Enter
key Enter
key Enter
expect title = /MUSICIANS/H/Hubbard_Rob
expect rows[0].text = Commando.sid
key Enter
expect screen = playing
expect player.state = playing
# "More", and the last thing it offers.
key 8
expect panel.id = more-playing
key End
key Enter
expect panel.id = text
expect place = text
expect panel.text contains "with an é in it"
expect panel.text matches "^  TITLE: Commando Test\n ARTIST: Test Author\nCOMMENT: A fixture's note, with an é in it to show that STIL is Latin-1\.$"
# The tune plays on under the panel, and Enter closes it.
expect player.state = playing
key Enter
expect panel = null
expect screen = playing
