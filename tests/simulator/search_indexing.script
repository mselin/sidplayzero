# SPDX-License-Identifier: GPL-3.0-or-later
# SPEC-100 SPEC-161 while the index is being built, Search shows "Indexing n %" and searches what has been indexed so far
# fixture: collections/85/C64Music C64Music
# fakes: fakes/browse_slow_listing

# Every listing of a folder takes one second of the fake clock. The start comes first (SPEC-200: the
# clean-up of SPEC-202, which lists the app's own folders, and then the index's check), so the build's
# second step, which walks the collection's folders one after another, reads files only some seconds in.
# Ten seconds in, its first step has given every tune HVSC lists a record, and the walk has not yet reached
# /MUSICIANS/T/Tester_Tom, the last folder of the fixture collection.
advance 10000
expect screen = browser
expect title = /
expect rows[0].text = DEMOS
key 5
expect screen = search
expect place = search-field
expect text matches Indexing [0-9]+ %

# A word of a path finds its tune already.
type songs
key Enter
expect place = search-results
expect list.total = 1
expect position = 1/1
expect rows[0].text = Three_Songs.sid
expect text matches Indexing [0-9]+ %

# A word of its title does not yet: its file has not been read.
key 4
expect place = search-field
key End
key Space
type subtunes
expect fields matches "text":"songs subtunes"[,}]
key Enter
expect text contains "No results"
expect text matches Indexing [0-9]+ %
key Esc
expect screen = browser

# A minute is far more than the walk needs. The index is complete, and the same query finds the tune.
advance 60000
key 5
expect screen = search
expect place = search-field
expect text matches ^(?![\s\S]*Indexing)
key End
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
key Backspace
expect fields matches "text":""[,}]
type songs
key Space
type subtunes
key Enter
expect place = search-results
expect list.total = 1
expect rows[0].text = Three_Songs.sid
expect text matches ^(?![\s\S]*Indexing)
expect-requests 0
